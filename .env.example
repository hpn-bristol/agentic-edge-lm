# OpenAI-compatible planner configuration.
# Copy this file to .env and fill in your own key before running the MA controller.
OPENAI_API_KEY=<your-openai-api-key>
LLM_POLICY_MODEL=<planner-model-name>
LOCAL_GPT_MODEL=<local-controller-model-name>

# Runtime state paths. Defaults are repo-local if unset.
# ELLM_STATE_DIR=./runtime_state
# ELLM_POLICY_DIR=./runtime_state/llm_policy

# Macro planning cadence.
LLM_MACRO_EPOCH_SLOTS=50
LLM_MACRO_EVAL_PREFIX=30
LLM_MACRO_EVAL_WARMUP=10

# Set to 0 if you want to run the controller without spawning the Kubernetes monitor.
LLM_SPAWN_MONITOR=1

# Docker image prefix used by deploy/build scripts.
IMAGE_PREFIX=local/elm
