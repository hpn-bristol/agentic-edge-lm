FROM python:3.10

# Install system dependencies
RUN apt-get update && apt-get install -y \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
RUN pip install --no-cache-dir torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu118 && \
    pip install --no-cache-dir kubernetes accelerate httpx requests asyncio aiofiles transformers && \
    pip install --no-cache-dir motor pandas fastapi pydantic uvicorn pymongo pillow


WORKDIR /app

COPY ../inference/inference_lm2.py /app/inference_lm2.py
COPY ../inference/download_model_2.py /app/download_model_2.py


RUN python /app/download_model_2.py


